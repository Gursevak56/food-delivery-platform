APP_NAME=Rider Delivery Service
ENVIRONMENT=development
PORT=8084
HTTP_READ_TIMEOUT=10s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
HTTP_SHUTDOWN_TIMEOUT=10s

DATABASE_URL=postgres://postgres:postgres@postgres:5432/rider_service?sslmode=disable
POSTGRES_MAX_OPEN_CONNS=20
POSTGRES_MAX_IDLE_CONNS=10
POSTGRES_CONN_MAX_LIFETIME=30m

MONGO_URI=mongodb://mongo:27017
MONGO_DATABASE=rider_service
REDIS_URL=redis://redis:6379

JWT_SECRET=change-this-secret
JWT_ISSUER=rider-service
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=720h
OTP_EXPIRY=5m
OTP_MAX_RETRIES=5
OTP_MAX_RESENDS=3
PASSWORD_HASH_COST=12
EXPOSE_OTP_IN_DEV=true
DEVICE_FINGERPRINT_ENABLED=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

ORDER_ACCEPT_TIMEOUT_SECONDS=45
PICKUP_OTP_REQUIRED=true
DELIVERY_OTP_REQUIRED=true
RIDER_MAX_ACTIVE_ORDERS=1
BREAK_RULE_MINUTES=30
SHIFT_AUTO_START=true
SURGE_MULTIPLIER_DEFAULT=1.0
PAYOUT_MIN_THRESHOLD=500
USE_IN_MEMORY_STORE=true
